#!/bin/sh /etc/rc.common

USE_PROCD=1

START=99
STOP=10

NAME=modemwebui

DEFAULT_LAN_ADDR=192.168.1.1

get_lan_addr() {
    local lan_addr

    lan_addr=$(uci -q get network.lan.ipaddr 2>/dev/null)
    [ -n "$lan_addr" ] || lan_addr=$DEFAULT_LAN_ADDR

    echo "$lan_addr"
}

write_web_config() {
    local config_file=$1
    local lan_addr
    local tmp_file

    [ -f "${config_file}.bak" ] || return 1

    lan_addr=$(get_lan_addr)
    tmp_file="${config_file}.tmp.$$"

    if ! sed "s/192\.168\.1\.1/$lan_addr/g" "${config_file}.bak" > "$tmp_file"; then
        rm -f "$tmp_file"
        return 1
    fi

    mv -f "$tmp_file" "$config_file"
}

write_all_web_configs() {
    local config_file

    for config_file in \
        /www/webui/webui000/web/config.json \
        /www/webui/webui5700/web/config.json
    do
        [ -f "${config_file}.bak" ] && write_web_config "$config_file"
    done
}

replace_and_start() {
    CONFIG_FILE=$1
    SERVER_PY=$2

    write_web_config "$CONFIG_FILE"
    start-stop-daemon -S -b -m -p $PIDFILE -x /usr/bin/python3 -- $SERVER_PY
    sleep 1
    rm -rf /tmp/luci-*
    exit 0
}

start_service_instance() {
    local CONFIG_FILE=$1
    
    sleep 6
    write_web_config "$CONFIG_FILE"
    
    # 使用procd启动服务，支持自动重启
    # 通过sh -c在webuiserver所在目录执行，使用相对路径启动
    procd_open_instance
    procd_set_param command /bin/sh -c "cd '$(dirname "$CONFIG_FILE")/../' && exec '/usr/bin/webuiserver'"
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-0}
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
    
    sleep 1
    rm -rf /tmp/luci-*
}

start_service() {
    # Generate both frontend configs before probing for a modem. This also
    # restores config.json when only the packaged .bak file is present.
    write_all_web_configs

    retry_times=10
    while [ "$retry_times" -gt 0 ]; do
        lsusb_output=$(lsusb)
        if echo "$lsusb_output" | grep -q "MT5700M-CN"; then
            start_service_instance \
                /www/webui/webui5700/web/config.json
            return
        elif echo "$lsusb_output" | grep -q "0e8d:7127" || 
            echo "$lsusb_output" | grep -q "FM350-GL" ||
            echo "$lsusb_output" | grep -q "RM500Q" ||
            echo "$lsusb_output" | grep -q "RM502Q" ||
            echo "$lsusb_output" | grep -q "RM551E" ||
            echo "$lsusb_output" | grep -q "RM520F" ||
            echo "$lsusb_output" | grep -q "RM521F" ||
            echo "$lsusb_output" | grep -q "RG501Q" ||
            echo "$lsusb_output" | grep -q "RG520F" ||
            echo "$lsusb_output" | grep -q "RM510Q" ||
            echo "$lsusb_output" | grep -q "RM520N"; then
            start_service_instance \
                /www/webui/webui000/web/config.json
            return
        else
            sleep 30
            retry_times=$((retry_times-1))
        fi
    done
}

service_triggers() {
    procd_add_reload_trigger network
}

reload_service() {
    write_all_web_configs
    rm -rf /tmp/luci-*
}

stop_service() {
    # procd会自动处理停止
    return 0
} 
